{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project D negotiation response v1",
  "description": "The exact subject and feature sets must match task.required, omitting empty subjects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode",
    "schema_version",
    "instruction_version",
    "manifest_sha256",
    "provenance",
    "labels"
  ],
  "properties": {
    "episode": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1"
    },
    "instruction_version": {
      "const": "2"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B"
      ],
      "properties": {
        "A": {
          "$ref": "#/$defs/agent"
        },
        "B": {
          "$ref": "#/$defs/agent"
        },
        "episode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "submission_order_agreed"
          ],
          "properties": {
            "submission_order_agreed": {
              "$ref": "#/$defs/category"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "date",
        "method"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "pattern": "^(unknown|[0-9]{4}-[0-9]{2}-[0-9]{2})$"
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "basis": {
      "type": "object",
      "required": [
        "value",
        "reason",
        "evidence"
      ],
      "properties": {
        "value": {},
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(E[0-9]{4,}|USER-[AB])$"
          }
        }
      },
      "additionalProperties": false
    },
    "category": {
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        },
        {
          "properties": {
            "value": {
              "enum": [
                "yes",
                "no",
                "unclear",
                "not_applicable"
              ]
            }
          }
        }
      ]
    },
    "intent": {
      "allOf": [
        {
          "$ref": "#/$defs/basis"
        },
        {
          "properties": {
            "value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pairs",
                "source",
                "contradiction"
              ],
              "properties": {
                "pairs": {
                  "oneOf": [
                    {
                      "enum": [
                        "none",
                        "unclear"
                      ]
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  ]
                },
                "source": {
                  "enum": [
                    "message",
                    "structured_proposal",
                    "both",
                    "unknown"
                  ]
                },
                "contradiction": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_intent": {
          "$ref": "#/$defs/intent"
        },
        "final_intent": {
          "$ref": "#/$defs/intent"
        },
        "cost_mentioned": {
          "$ref": "#/$defs/category"
        },
        "conflict_detected": {
          "$ref": "#/$defs/category"
        },
        "own_change_proposed": {
          "$ref": "#/$defs/category"
        },
        "own_priority_correct": {
          "$ref": "#/$defs/category"
        },
        "partner_priority_understood": {
          "$ref": "#/$defs/category"
        },
        "explicit_root_yield": {
          "$ref": "#/$defs/category"
        },
        "decision_deferred_to_environment": {
          "$ref": "#/$defs/category"
        }
      }
    }
  }
}
