{"seq": 29, "scenario_id": "dev_s0_01", "mode": "A/R3P", "time": 13, "agent_id": "A", "request_id": null, "event_type": "auto_wait", "job_id": null, "option_id": null, "cost": null, "spent_before": 0, "spent_after": 0, "held_before": 0, "held_after": 0, "result": "between_rounds", "detail": {"until": 20}}
